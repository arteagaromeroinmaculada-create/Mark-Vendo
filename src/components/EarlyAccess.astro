---
import Msg from './Msg.astro';
---
<section class="blk" id="acceso-anticipado" aria-labelledby="early-h">
  <p class="day">Acceso anticipado</p>
  <Msg tail wide>
    <span class="kicker">Una cosa más 🎟️</span>
    <h2 class="h" id="early-h">Busco salas, productoras y artistas que quieran probarme <em class="s hl">antes del lanzamiento</em>.</h2>
    <ul class="lite">
      <li>Me pruebas con tus próximos espectáculos.</li>
      <li>Me cuentas qué te sirve y qué no.</li>
      <li>Hablamos de condiciones antes de empezar, sin compromiso.</li>
    </ul>
    <span class="meta">10:13</span>
  </Msg>
  <div class="qr"><a class="primary" href="#contacto" data-track="cta_click" data-loc="acceso-anticipado">Quiero ser uno de los primeros</a></div>
</section>

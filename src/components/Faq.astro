---
import Msg from './Msg.astro';
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<section class="blk" id="preguntas" aria-labelledby="faq-h">
  <Msg tail wide>
    <h2 class="h" id="faq-h">Lo que más me preguntan</h2>
    <p>Toca una pregunta y te contesto.</p>
  </Msg>
  <div class="faq">
    {items.map((f, i) => (
      <details>
        <summary><span class="msg msg--you msg--tail">{f.q}</span></summary>
        <div class="msg msg--mark msg--tail"><p>{f.a}</p></div>
      </details>
    ))}
  </div>
</section>

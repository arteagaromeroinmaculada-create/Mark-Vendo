---
import Base from '../layouts/Base.astro';
import Msg from '../components/Msg.astro';
import Icon from '../components/Icon.astro';
import Demo from '../components/Demo.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import EarlyAccess from '../components/EarlyAccess.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import { SITE } from '../config/site';
import { SEGMENTS, type Segment } from '../content/segments';
import { FAQ } from '../content/faq';

export function getStaticPaths() {
  return SEGMENTS.map((s) => ({ params: { nicho: s.slug }, props: { seg: s } }));
}
const { seg } = Astro.props as { seg: Segment };
const others = SEGMENTS.filter((s) => s.slug !== seg.slug);
const faq = [...seg.faq, ...FAQ.filter((f) => /instalar|permiso|cuesta|redes sociales/.test(f.q))];
const url = `${SITE.url}/${seg.slug}/`;
const who = { sala: 'Sala Ejemplo', promotor: 'Promotora Ejemplo', artista: 'Artista de ejemplo' }[seg.formValue] || 'Cliente de ejemplo';
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: `Mark Vendo para ${seg.short.toLowerCase()}`, url, serviceType: 'Marketing y creación de contenido para redes sociales', provider: { '@id': `${SITE.url}/#org` }, areaServed: { '@type': 'Country', name: 'España' }, audience: { '@type': 'Audience', audienceType: seg.short }, availableChannel: { '@type': 'ServiceChannel', name: 'WhatsApp' }, description: seg.seo.description },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` }, { '@type': 'ListItem', position: 2, name: seg.short, item: url }] },
];
---
<Base title={seg.seo.title} description={seg.seo.description} schema={schema} current={seg.slug} status={`en línea · Mark para ${seg.short.toLowerCase()}`}>
  <p class="day">Hoy</p>
  <p class="sys"><Icon name="lock" />Las conversaciones de esta página son ejemplos. No son clientes reales.</p>
  <section class="blk" aria-labelledby="hero-h">
    <Msg tail wide>
      <span class="kicker">{seg.kicker}</span>
      <h1 class="big" id="hero-h">{seg.seo.h1}</h1>
      <p class="lead">{seg.seo.lead}</p>
      <span class="meta">10:01</span>
    </Msg>
    <div class="qr qr--row">
      <a class="primary" href="#contacto" data-segment={seg.formValue} data-track="cta_click" data-loc="hero-nicho">{seg.cta}</a>
      <a href="#como-funciona">¿Cómo funciona?</a>
    </div>
    <Msg wide fwd="Reenviado" time="10:01">Así trabajamos 👇<Demo messages={seg.chat} who={who} /></Msg>
  </section>

  <section class="blk" aria-labelledby="dolor-h">
    <Msg tail wide><span class="kicker">Te entiendo</span><h2 class="h" id="dolor-h">«{seg.quote}»</h2></Msg>
    {seg.pains.map((p, i) => <Msg from="you" tail={i === 0} time={i === seg.pains.length - 1 ? '10:03' : undefined}>{p}</Msg>)}
    <Msg tail><p class="serif-big">Para eso <mark>estoy yo</mark>.</p></Msg>
  </section>

  <HowItWorks />

  <section class="blk" id="campanas" aria-labelledby="camp-h">
    <Msg from="you" tail time="10:08">¿Y qué me preparas exactamente?</Msg>
    <Msg tail wide>
      <span class="kicker">Lo que preparo para {seg.short.toLowerCase()}</span>
      <h2 class="h" id="camp-h">Lo que hago con <em class="s hl">tu material</em>.</h2>
      <ol class="steps">{seg.campaign.map((c, i) => <li><span class="n">{i + 1}</span><span><b>{c.title}</b>{c.text}</span></li>)}</ol>
      <span class="meta">10:09</span>
    </Msg>
  </section>

  <Features />
  <EarlyAccess />
  <Faq items={faq} />

  <section class="blk" aria-labelledby="otros-h">
    <Msg tail><h2 class="h3" id="otros-h">También trabajo para</h2></Msg>
    <div class="qr">{others.map((o) => <a href={`/${o.slug}/`}>{o.short} →</a>)}</div>
  </section>

  <Contact preset={seg.formValue} />
</Base>
